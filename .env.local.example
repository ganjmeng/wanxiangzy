# Production required
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe billing
# Keep secret keys server-only. Never commit real or test secrets.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Task queue read model
# redis: Upstash hot cache -> task_queue_items fallback -> legacy fallback.
# supabase: task_queue_items only, then legacy fallback.
# legacy: old generations/agent_workflows scan path for emergency rollback.
TASK_QUEUE_CACHE_MODE=redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Feature required: image generation providers
LINGYA_BASE_URL=https://api.lingyaai.cn
LINGYA_API_KEY=your-lingya-api-key

# GPT-Image-2 app option is routed through CatRouter by default.
# Set GPT_IMAGE_PROVIDER=plato to switch back to the previous OpenAI-compatible Plato/Yunwu slot.
GPT_IMAGE_PROVIDER=catrouter
CATROUTER_BASE_URL=https://api.catrouter.net
CATROUTER_API_KEY=your-catrouter-api-key
CATROUTER_GPT_IMAGE_MODEL=gpt-image-2
CATROUTER_NANO_BANANA_MODEL=gemini-3.1-flash-image-preview
CATROUTER_NANO_BANANA_PRO_MODEL=gemini-3-pro-image-preview

# Nano Banana app options are routed through Gemini native generateContent.
# Default is Yunwu native; set NANO_BANANA_PROVIDER=catrouter or laozhang to switch.
NANO_BANANA_PROVIDER=yunwu
YUNWU_NATIVE_BASE_URL=https://yunwu.ai
YUNWU_NATIVE_API_KEY=your-yunwu-native-api-key
YUNWU_NANO_BANANA_MODEL=gemini-3.1-flash-image-preview
YUNWU_NANO_BANANA_PRO_MODEL=gemini-3-pro-image-preview

# LaoZhang stays available as the backup Gemini native provider.
LAOZHANG_BASE_URL=https://api.laozhang.ai
LAOZHANG_API_KEY=your-laozhang-api-key
# LAOZHANG_NANO_BANANA_MODEL=gemini-3.1-flash-image-preview
# LAOZHANG_NANO_BANANA_PRO_MODEL=gemini-3-pro-image-preview

# AI video is routed through Yunwu HappyHorse.
HAPPYHORSE_BASE_URL=https://yunwu.ai
HAPPYHORSE_API_KEY=
# Optional: shared Yunwu fallback used when HAPPYHORSE_API_KEY is empty.
YUNWU_API_KEY=
YUNWU_API_BASE_URL=https://yunwu.ai

# Previous GPT-Image-2 fallback slot.
PLATO_BASE_URL=https://yunwu.ai
PLATO_API_KEY=your-plato-api-key
# Optional: override the provider-specific model id.
# PLATO_GPT_IMAGE_MODEL=gpt-image-2

# Feature required: prompt analysis / prompt optimization
ANALYZE_LLM_PROVIDER=xiaomi
LINGYA_VISION_MODEL=gpt-4o-mini
NEXT_PUBLIC_ENABLE_PROMPT_ANALYSIS=true

XIAOMI_MIMO_API_KEY=your-xiaomi-mimo-api-key
XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
XIAOMI_MIMO_MODEL=mimo-v2.5-pro
XIAOMI_MIMO_TEXT_MODEL=mimo-v2.5-pro
XIAOMI_MIMO_VISION_MODEL=mimo-v2.5

# Comma-separated extra hosts allowed by /api/download-image.
# Example: DOWNLOAD_IMAGE_ALLOWED_HOSTS=example-cdn.com,*.example-storage.com
DOWNLOAD_IMAGE_ALLOWED_HOSTS=

# API platform test page proxy allowlist.
# Keep this narrow in production to avoid exposing a generic server-side fetch proxy.
API_PLATFORM_TEST_ALLOWED_HOSTS=value.apiqik.online,hk-api.gptbest.vip,api.bltcy.ai,api.whatai.cc

# Image storage adapter
# Use "imgbb" or "aliyun-oss". Aliyun OSS is recommended for production durable storage.
IMAGE_STORAGE_PROVIDER=imgbb
IMGBB_API_KEY=your-imgbb-api-key

# Required when IMAGE_STORAGE_PROVIDER=aliyun-oss
# Example for Hong Kong bucket:
# ALIYUN_OSS_REGION=oss-cn-hongkong
# ALIYUN_OSS_BUCKET=vastweargen-images
# ALIYUN_OSS_PUBLIC_BASE_URL=https://vastweargen-images.oss-cn-hongkong.aliyuncs.com
# NEXT_PUBLIC_ALIYUN_OSS_IMAGE_HOSTS=vastweargen-images.oss-cn-hongkong.aliyuncs.com
# ALIYUN_OSS_ACCESS_KEY_ID=your-ram-access-key-id
# ALIYUN_OSS_ACCESS_KEY_SECRET=your-ram-access-key-secret
# Optional: use a CDN/CNAME domain for signed download redirects. Defaults to ALIYUN_OSS_PUBLIC_BASE_URL.
# ALIYUN_OSS_DOWNLOAD_BASE_URL=https://images.example.com
# Optional storage prefixes. Keep original files here; thumbnails are generated by OSS on read.
# ALIYUN_OSS_PREFIX=ai-tryon
# ALIYUN_OSS_SITE_ASSET_PREFIX=site-assets/original
# ALIYUN_OSS_UPLOAD_PREFIX=user-uploads/original
# ALIYUN_OSS_GENERATED_PREFIX=generated-results/original
# ALIYUN_OSS_FAVORITE_PREFIX=user-favorites/original
# ALIYUN_OSS_TEMP_PREFIX=temp/original
# Optional override. Defaults to ${bucket}.${region}.aliyuncs.com.
# ALIYUN_OSS_ENDPOINT=vastweargen-images.oss-cn-hongkong.aliyuncs.com

# Feature required: durable background processors
# Use at least 32 random characters in production. Never deploy change-me.
# Used as Bearer token for /api/jobs/process-generations.
# Also accepted by /api/jobs/process-agent-workflows and /api/jobs/run-agent-evals.
JOB_PROCESSOR_SECRET=replace-with-at-least-32-random-characters
# Optional route-specific overrides:
AGENT_WORKFLOW_PROCESSOR_SECRET=
AGENT_EVAL_PROCESSOR_SECRET=
# Optional legacy/shared cron secret fallback:
CRON_SECRET=
GENERATION_JOB_BATCH_SIZE=2
GENERATION_JOB_STALE_MINUTES=8
AGENT_WORKFLOW_BATCH_SIZE=2

# Optional legacy / experimental providers
FASHN_API_KEY=
REPLICATE_API_TOKEN=
