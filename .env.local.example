# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Image generation providers
LINGYA_BASE_URL=https://api.lingyaai.cn
LINGYA_API_KEY=your-lingya-api-key

# GPT-Image-2 uses Plato first; falls back to LINGYA_API_KEY only when PLATO_API_KEY is empty.
PLATO_BASE_URL=https://api.bltcy.ai
PLATO_API_KEY=your-plato-api-key

# Prompt analysis / prompt optimization
ANALYZE_LLM_PROVIDER=xiaomi
LINGYA_VISION_MODEL=gpt-4o-mini
NEXT_PUBLIC_ENABLE_PROMPT_ANALYSIS=true

XIAOMI_MIMO_API_KEY=your-xiaomi-mimo-api-key
XIAOMI_MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
XIAOMI_MIMO_MODEL=mimo-v2.5-pro
XIAOMI_MIMO_TEXT_MODEL=mimo-v2.5-pro
XIAOMI_MIMO_VISION_MODEL=mimo-v2.5

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated extra hosts allowed by /api/download-image.
# Example: DOWNLOAD_IMAGE_ALLOWED_HOSTS=example-cdn.com,*.example-storage.com
DOWNLOAD_IMAGE_ALLOWED_HOSTS=

# API platform test page proxy allowlist.
# Keep this narrow in production to avoid exposing a generic server-side fetch proxy.
API_PLATFORM_TEST_ALLOWED_HOSTS=value.apiqik.online,hk-api.gptbest.vip,api.bltcy.ai,api.whatai.cc

# ImgBB image upload (https://api.imgbb.com)
IMGBB_API_KEY=your-imgbb-api-key

# Durable generation job processor
# Use this as Bearer token for /api/jobs/process-generations.
# The same secret is also accepted by /api/jobs/process-agent-workflows.
JOB_PROCESSOR_SECRET=change-me
GENERATION_JOB_BATCH_SIZE=2
GENERATION_JOB_STALE_MINUTES=8
AGENT_WORKFLOW_BATCH_SIZE=2

# Next-generation Agent runtime.
# /agent now uses assistant-ui by default. Mastra is the production runtime; legacy fallback is opt-in below.
AGENT_CHAT_V2_ENABLED=true
AGENT_RUNTIME_PROVIDER=mastra
AGENT_UI_PROVIDER=assistant_ui
# Mastra Agent text model. When XIAOMI_MIMO_API_KEY is configured, this model is sent to the Xiaomi OpenAI-compatible endpoint.
AGENT_MASTRA_MODEL=mimo-v2.5-pro
AGENT_MASTRA_TRACE_ENABLED=true
AGENT_MASTRA_EVAL_ENABLED=true
AGENT_MASTRA_MEMORY_ENABLED=true
# Keep legacy keyword fallback disabled by default. Set to 1 only during emergency rollback.
AGENT_ALLOW_LEGACY_FALLBACK=0
# Confirming a workflow immediately wakes an in-process worker; cron remains the durable fallback.
AGENT_WORKFLOW_INLINE_WAKE=1
AGENT_WORKFLOW_STALE_AFTER_MINUTES=10
AGENT_WORKFLOW_REPAIR_BATCH_SIZE=4
# Generated images are reviewed before completion; bad outputs can auto-repair the prompt and retry once.
AGENT_WORKFLOW_QUALITY_REPAIR_ENABLED=true
AGENT_WORKFLOW_QUALITY_REPAIR_MAX_ATTEMPTS=1
# Optional dedicated secret for /api/jobs/repair-agent-workflows. Falls back to JOB_PROCESSOR_SECRET/CRON_SECRET.
AGENT_WORKFLOW_REPAIR_SECRET=
# Optional dedicated secret for /api/jobs/agent-health. Falls back to JOB_PROCESSOR_SECRET/CRON_SECRET.
AGENT_HEALTH_PROCESSOR_SECRET=

# Optional legacy / experimental providers
FASHN_API_KEY=
REPLICATE_API_TOKEN=
