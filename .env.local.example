# Production required
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe billing
# Keep secret keys server-only. Never commit real or test secrets.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Task queue read model
# redis: Upstash hot cache -> task_queue_items fallback -> legacy fallback.
# supabase: task_queue_items only, then legacy fallback.
# legacy: old generations/agent_workflows scan path for emergency rollback.
TASK_QUEUE_CACHE_MODE=redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# redis: distributed capacity pool with process-local availability fallback.
# local: development/single-process only. Production multi-instance should use redis.
AI_ROUTER_CAPACITY_MODE=redis

# Image generation, vision recognition, prompt/text LLM, and AI video providers
# are configured in the admin portal and stored in Supabase:
#   - model.providers  (gpt-image-2 / nano-banana-2 / nano-banana-pro)
#   - llm.providers    (vision / text)
#   - video.providers  (MiniMax H3 / HappyHorse)
# Do not set provider env fallbacks here for these modules.

# AI toolbox runtime
# Development can use mock to exercise UI/UX without consuming Provider quota.
# Production rejects mock. Keep the operation list empty until the external
# Aliyun matting/upscale Gateway is verified. Generative edit tools reuse the
# model providers published in /admin/providers; resize is local Sharp.
AI_TOOLS_EXECUTION_MODE=mock
AI_TOOLS_PROVIDER_GATEWAY_URL=
AI_TOOLS_PROVIDER_GATEWAY_TOKEN=
AI_TOOLS_PROVIDER_OPERATIONS=
AI_TOOLS_PROVIDER_TIMEOUT_MS=45000
# Independent HMAC secrets. Generate with: openssl rand -hex 32
RESOURCE_LIBRARY_UPLOAD_TOKEN_SECRET=replace-with-64-hex-secret
AI_TOOL_ASSET_REF_SECRET=replace-with-another-64-hex-secret
# Signed mask references live for 30 minutes (allowed range: 300-86400).
AI_TOOL_MASK_REF_TTL_SECONDS=1800

# Optional: used by scripts/seed-provider-configs.ts to bootstrap video.providers.
# Not required at runtime once the admin config has been published.
# Shared api.new.bi credential. The unified control plane can use it for the
# lower-priority image-edit fallback and NewAPI video deployments.
VIDEO_API_KEY=
MINIMAX_VIDEO_API_KEY=
MINIMAX_VIDEO_BASE_URL=https://api.new.bi
MINIMAX_VIDEO_MODEL=minimax-h3

NEXT_PUBLIC_ENABLE_PROMPT_ANALYSIS=true

# Product-retouch runtime Skill. Set to false to keep the feature open while
# forcing the built-in safe Skill (recommended for the database migration window).
PRODUCT_RETOUCH_RUNTIME_SKILL_ENABLED=true

# Comma-separated extra hosts allowed by /api/download-image.
# Example: DOWNLOAD_IMAGE_ALLOWED_HOSTS=example-cdn.com,*.example-storage.com
DOWNLOAD_IMAGE_ALLOWED_HOSTS=

# API platform test page proxy allowlist.
# Keep this narrow in production to avoid exposing a generic server-side fetch proxy.
API_PLATFORM_TEST_ALLOWED_HOSTS=value.apiqik.online,hk-api.gptbest.vip,api.bltcy.ai,api.whatai.cc

# Image storage adapter
# Use "imgbb" or "aliyun-oss". Aliyun OSS is recommended for production durable storage.
IMAGE_STORAGE_PROVIDER=imgbb
IMGBB_API_KEY=your-imgbb-api-key

# Required when IMAGE_STORAGE_PROVIDER=aliyun-oss
# Example for Hong Kong bucket:
# ALIYUN_OSS_REGION=oss-cn-hongkong
# ALIYUN_OSS_BUCKET=vasthk
# ALIYUN_OSS_PUBLIC_BASE_URL=https://vasthk.oss-cn-hongkong.aliyuncs.com
# NEXT_PUBLIC_ALIYUN_OSS_IMAGE_HOSTS=vasthk.oss-cn-hongkong.aliyuncs.com,vasthk.cn-hongkong.thepacificgls.com
# ALIYUN_OSS_ACCESS_KEY_ID=your-ram-access-key-id
# ALIYUN_OSS_ACCESS_KEY_SECRET=your-ram-access-key-secret
# Optional: use a CDN/CNAME domain for signed download redirects. Defaults to ALIYUN_OSS_PUBLIC_BASE_URL.
# ALIYUN_OSS_DOWNLOAD_BASE_URL=https://images.example.com
# Optional storage prefixes. Keep original files here; thumbnails are generated by OSS on read.
# ALIYUN_OSS_PREFIX=ai-tryon
# ALIYUN_OSS_SITE_ASSET_PREFIX=site-assets/original
# ALIYUN_OSS_UPLOAD_PREFIX=user-uploads/original
# ALIYUN_OSS_GENERATED_PREFIX=generated-results/original
# ALIYUN_OSS_FAVORITE_PREFIX=user-favorites/original
# ALIYUN_OSS_TEMP_PREFIX=temp/original
# Optional override. Defaults to ${bucket}.${region}.aliyuncs.com.
# ALIYUN_OSS_ENDPOINT=vasthk.oss-cn-hongkong.aliyuncs.com

# Cloud-pull generated results directly from provider URLs into OSS.
# Run `npm run oss:configure-mirror` once after the resolver route is deployed,
# then enable the runtime flag. The signing key must be independent from the
# OSS AccessKey and at least 32 random characters. Provider URLs are encrypted
# with ADMIN_SECRETS_ENCRYPTION_KEY before entering Postgres.
# ALIYUN_OSS_MIRROR_ENABLED=false
# ALIYUN_OSS_MIRROR_SIGNING_SECRET=replace-with-at-least-32-random-characters
# Required exact/wildcard provider host allowlist; never use a global wildcard.
# ALIYUN_OSS_MIRROR_ALLOWED_HOSTS=provider.example.com,*.trusted-provider.example
# Optional; defaults to ${NEXT_PUBLIC_APP_URL}/api/oss-mirror-source/
# ALIYUN_OSS_MIRROR_RESOLVER_BASE_URL=https://example.com/api/oss-mirror-source/
# Optional; defaults to ${ALIYUN_OSS_GENERATED_PREFIX}/mirror
# ALIYUN_OSS_MIRROR_PREFIX=generated-results/original/mirror
# ALIYUN_OSS_MIRROR_TTL_SECONDS=1800
# ALIYUN_OSS_MIRROR_PREFLIGHT_TIMEOUT_MS=12000
# ALIYUN_OSS_MIRROR_TRIGGER_TIMEOUT_MS=45000
# ALIYUN_OSS_MIRROR_WAIT_TIMEOUT_MS=240000
# ALIYUN_OSS_MIRROR_MAX_BYTES=67108864
# ALIYUN_OSS_MIRROR_MAX_ATTEMPTS=8
# ALIYUN_OSS_MIRROR_RETRY_BASE_MS=750
# ALIYUN_OSS_MIRROR_CONCURRENCY=16
# ALIYUN_OSS_MIRROR_WORKER_BATCH_SIZE=50
# ALIYUN_OSS_MIRROR_WORKER_POLL_INTERVAL_MS=1000
# ALIYUN_OSS_MIRROR_WORKER_IDLE_BACKOFF_MAX_MS=10000
# ALIYUN_OSS_MIRROR_COMPLETED_RETENTION_DAYS=7
# ALIYUN_OSS_MIRROR_FAILED_RETENTION_DAYS=3

# Feature required: durable background processors
# Use at least 32 random characters in production. Never deploy change-me.
# Used as Bearer token for /api/jobs/process-generations.
# Also accepted by /api/jobs/process-agent-workflows and /api/jobs/run-agent-evals.
JOB_PROCESSOR_SECRET=replace-with-at-least-32-random-characters
# Optional route-specific overrides:
AGENT_WORKFLOW_PROCESSOR_SECRET=
AGENT_EVAL_PROCESSOR_SECRET=
# Optional legacy/shared cron secret fallback:
CRON_SECRET=
GENERATION_JOB_BATCH_SIZE=2
GENERATION_JOB_STALE_MINUTES=8
AGENT_WORKFLOW_BATCH_SIZE=2

# Optional legacy / experimental providers
FASHN_API_KEY=
REPLICATE_API_TOKEN=

# Cloudflare API token for DNS / edge automation
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Encryption key for admin-configured provider API keys (AES-256-GCM).
ADMIN_SECRETS_ENCRYPTION_KEY=replace-with-64-hex-aes-256-key
