# Production required
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe billing
# Keep secret keys server-only. Never commit real or test secrets.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Shared standard Redis endpoint for BullMQ, provider capacity, upload admission,
# and task-cache hot data.
#
# Self-hosted Redis on the same EC2 host (bind 127.0.0.1, requirepass set):
#   redis://:<password>@127.0.0.1:6379/15
# The password is generated on EC2 and saved to ~/.wanxiangzy-redis-url.
# The Redis server MUST use maxmemory-policy=noeviction (the deploy gate rejects
# evicting policies because they can silently drop BullMQ job state).
REDIS_URL=redis://:<your-redis-password>@127.0.0.1:6379/15

# Task queue read model
# redis: standard Redis hot cache -> task_queue_items fallback -> legacy fallback.
# supabase: task_queue_items only, then legacy fallback.
# legacy: old generations/agent_workflows scan path for emergency rollback.
TASK_QUEUE_CACHE_MODE=redis

# Provider concurrency and rolling RPM. Local mode is development/test only;
# production always fails closed on the distributed Redis backend.
AI_ROUTER_CAPACITY_MODE=redis
AI_ROUTER_CAPACITY_WAIT_MS=90000

# Kie Market credentials are server-only and are encrypted into the unified
# control plane by scripts/reconfigure-kie-models.ts.
KIE_BANANA_API_KEY=
KIE_GPT_IMAGE_API_KEY=
KIE_QWEN_API_KEY=
KIE_VIDEO_API_KEY=
KIE_MARKET_POLL_INTERVAL_MS=5000
KIE_MARKET_TASK_TIMEOUT_MS=1200000

NEXT_PUBLIC_ENABLE_PROMPT_ANALYSIS=true

# Product-retouch runtime Skill. Set to false to keep the feature open while
# forcing the built-in safe Skill (recommended for the database migration window).
PRODUCT_RETOUCH_RUNTIME_SKILL_ENABLED=true

# Comma-separated extra hosts allowed by /api/download-image.
# Example: DOWNLOAD_IMAGE_ALLOWED_HOSTS=example-cdn.com,*.example-storage.com
DOWNLOAD_IMAGE_ALLOWED_HOSTS=

# API platform test page proxy allowlist.
# Keep this narrow in production to avoid exposing a generic server-side fetch proxy.
API_PLATFORM_TEST_ALLOWED_HOSTS=value.apiqik.online,hk-api.gptbest.vip,api.bltcy.ai,api.whatai.cc

# Image storage adapter. Production is fail-closed unless this is aliyun-oss.
# Development may explicitly opt into imgbb, but there is no automatic fallback.
IMAGE_STORAGE_PROVIDER=aliyun-oss

# Required when IMAGE_STORAGE_PROVIDER=aliyun-oss
# Example for Hong Kong bucket:
# ALIYUN_OSS_REGION=oss-cn-hongkong
# ALIYUN_OSS_BUCKET=vasthk
# ALIYUN_OSS_PUBLIC_BASE_URL=https://vasthk.oss-cn-hongkong.aliyuncs.com
# NEXT_PUBLIC_ALIYUN_OSS_IMAGE_HOSTS=vasthk.oss-cn-hongkong.aliyuncs.com,vasthk.cn-hongkong.thepacificgls.com
# ALIYUN_OSS_ACCESS_KEY_ID=your-ram-access-key-id
# ALIYUN_OSS_ACCESS_KEY_SECRET=your-ram-access-key-secret
# Optional: use a CDN/CNAME domain for signed download redirects. Defaults to ALIYUN_OSS_PUBLIC_BASE_URL.
# ALIYUN_OSS_DOWNLOAD_BASE_URL=https://images.example.com
# Optional storage prefixes. Keep original files here; thumbnails are generated by OSS on read.
# ALIYUN_OSS_PREFIX=ai-tryon
# ALIYUN_OSS_SITE_ASSET_PREFIX=site-assets/original
# ALIYUN_OSS_UPLOAD_PREFIX=user-uploads/original
# ALIYUN_OSS_GENERATED_PREFIX=generated-results/original
# ALIYUN_OSS_FAVORITE_PREFIX=user-favorites/original
# ALIYUN_OSS_TEMP_PREFIX=temp/original
# Optional override. Defaults to ${bucket}.${region}.aliyuncs.com.
# ALIYUN_OSS_ENDPOINT=vasthk.oss-cn-hongkong.aliyuncs.com

# Durable generated-result persistence. Production requires stream or mirror;
# stream is the default and does not depend on OSS Website back-to-origin.
ALIYUN_OSS_REMOTE_TRANSFER_MODE=stream
ALIYUN_OSS_REMOTE_ALLOWED_HOSTS=tempfile.aiquickdraw.com,replace-with-provider-result-host.example.com
ALIYUN_OSS_MIRROR_SIGNING_SECRET=replace-with-at-least-32-random-characters
ALIYUN_OSS_MIRROR_PREFIX=generated-results/original/mirror
ALIYUN_OSS_MIRROR_TTL_SECONDS=1800
ALIYUN_OSS_MIRROR_WAIT_TIMEOUT_MS=240000
ALIYUN_OSS_MIRROR_MAX_BYTES=536870912
ALIYUN_OSS_MIRROR_MAX_ATTEMPTS=8
ALIYUN_OSS_REMOTE_CONCURRENCY=8
OSS_MIRROR_WORKER_BATCH_SIZE=8
OSS_MIRROR_WORKER_POLL_INTERVAL_MS=500
OSS_MIRROR_STALE_LEASE_SECONDS=480

# Durable video validation and retention cleanup workers. ffprobe must be
# installed on every worker host; claims are fenced in Postgres.
MEDIA_VALIDATION_BATCH_SIZE=12
MEDIA_VALIDATION_CONCURRENCY=4
MEDIA_VALIDATION_POLL_INTERVAL_MS=1000
MEDIA_VALIDATION_LEASE_SECONDS=180
MEDIA_VALIDATION_MAX_BYTES=536870912
MEDIA_VALIDATION_FFPROBE_TIMEOUT_MS=30000
MEDIA_VALIDATION_RECOVERY_INTERVAL_MS=60000
MEDIA_CLEANUP_BATCH_SIZE=20
MEDIA_CLEANUP_CONCURRENCY=4
MEDIA_CLEANUP_POLL_INTERVAL_MS=60000
MEDIA_CLEANUP_LEASE_SECONDS=300

# Browser-to-OSS upload data plane. Development defaults to server; production
# requires direct. This HMAC secret binds short-lived receipts to user/purpose/
# key/size/MIME/hash and must be independent from the OSS AccessKey secret.
UPLOAD_DELIVERY_MODE=server
UPLOAD_INTENT_SECRET=replace-with-an-independent-random-secret-at-least-32-bytes
UPLOAD_INTENT_TTL_SECONDS=300
UPLOAD_READ_URL_TTL_SECONDS=600
UPLOAD_IMAGE_MAX_MB=15
UPLOAD_VIDEO_MAX_MB=100
UPLOAD_AUDIO_MAX_MB=30
UPLOAD_SERVER_FALLBACK_MAX_MB=5
UPLOAD_IMAGE_MAX_PIXELS=40000000
UPLOAD_IMAGE_MAX_EDGE=12000
UPLOAD_DAILY_QUOTA_MB=2048
UPLOAD_INTENT_RATE_PER_MINUTE=120
UPLOAD_MAX_ACTIVE_INTENTS=20

# Feature required: durable background processors
# Use at least 32 random characters in production. Never deploy change-me.
# Used as Bearer token for /api/jobs/process-generations.
# Also accepted by /api/jobs/process-agent-workflows and /api/jobs/run-agent-evals.
JOB_PROCESSOR_SECRET=replace-with-at-least-32-random-characters
# Optional route-specific overrides:
AGENT_WORKFLOW_PROCESSOR_SECRET=
AGENT_EVAL_PROCESSOR_SECRET=
# Optional legacy/shared cron secret fallback:
CRON_SECRET=
AGENT_WORKFLOW_BATCH_SIZE=2

# Generation delivery. Production strictly requires BullMQ with REDIS_URL
# configured. Use inline only for a local dev server without a running worker.
GENERATION_QUEUE_MODE=bullmq
BULLMQ_PREFIX={wanxiangzy:generation}
BULLMQ_QUEUE_NAME=generation-jobs
BULLMQ_CONNECT_TIMEOUT_MS=5000
# Number of PM2 worker processes. Each process runs the full supervisor
# (BullMQ generation + OSS mirror + media validation/cleanup). Increase when
# adding CPU or EC2 instances; start with 1 on the current constrained host.
PM2_WORKER_INSTANCES=1
BULLMQ_WORKER_CONCURRENCY=64
# Per-generation image request fan-out. This is independent from BullMQ task
# concurrency and remains bounded by each model deployment's maxConcurrency.
GENERATION_IMAGE_BATCH_CONCURRENCY=8
GENERATION_MAX_ACTIVE_PER_USER=30
AI_USER_CONCURRENCY_STANDARD=12
AI_USER_CONCURRENCY_VIP=24
AI_USER_DEPLOYMENT_CONCURRENCY_STANDARD=6
AI_USER_DEPLOYMENT_CONCURRENCY_VIP=12
GENERATION_TASK_IMAGE_CONCURRENCY_STANDARD=6
GENERATION_TASK_IMAGE_CONCURRENCY_VIP=8
BULLMQ_LOCK_DURATION_MS=60000
BULLMQ_LOCK_RENEW_TIME_MS=20000
BULLMQ_STALLED_INTERVAL_MS=30000
BULLMQ_MAX_STALLED_COUNT=2
BULLMQ_COMPLETED_RETENTION_COUNT=5000
BULLMQ_COMPLETED_RETENTION_AGE_SECONDS=86400
BULLMQ_FAILED_RETENTION_COUNT=20000
BULLMQ_FAILED_RETENTION_AGE_SECONDS=604800
BULLMQ_JOB_ATTEMPTS=3
BULLMQ_JOB_BACKOFF_MS=5000
BULLMQ_RELAY_BATCH_SIZE=100
BULLMQ_RELAY_CONCURRENCY=8
BULLMQ_RELAY_POLL_INTERVAL_MS=500
BULLMQ_RELAY_CLAIM_TTL_MS=60000
WORKER_SHUTDOWN_TIMEOUT_MS=30000
WORKER_LOG_FORMAT=json

# Optional legacy / experimental providers
FASHN_API_KEY=
REPLICATE_API_TOKEN=

# Cloudflare API token for DNS / edge automation
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Encryption key for admin-configured provider API keys (AES-256-GCM).
ADMIN_SECRETS_ENCRYPTION_KEY=replace-with-64-hex-aes-256-key
